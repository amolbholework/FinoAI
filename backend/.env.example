# Copy to .env and adjust for your environment. Never commit the real .env.

APP_ENV=development

# SQLite is the zero-config local default. Point this at Postgres for anything beyond solo dev, e.g.:
# DATABASE_URL=postgresql+psycopg2://finpilot:finpilot@localhost:5432/finpilot
DATABASE_URL=sqlite:///./finpilot.db

CORS_ORIGINS=["http://localhost:5173"]

DEFAULT_CURRENCY=INR

# The only secret in this app. Get one at https://console.anthropic.com/ — the AI
# recommendation panel degrades gracefully (never breaks the dashboard) without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

MAX_CSV_UPLOAD_MB=5

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application).
GOOGLE_CLIENT_ID=
# Not used by the current ID-token-only flow (see app/core/config.py) — present for parity.
GOOGLE_CLIENT_SECRET=
# Random secret used to sign our own session JWTs — e.g. `openssl rand -hex 32`.
JWT_SECRET=
FRONTEND_URL=http://localhost:5173

# Free tier (100 requests/day) at https://www.marketaux.com/ — sign up, copy
# your API token here. The Finance News page degrades gracefully (shows an
# "unavailable" state, never breaks) without it.
MARKETAUX_API_KEY=
